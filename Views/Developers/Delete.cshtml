@model PhotoArchive.Models.Developer

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Developer</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <div class = "DelMess">
            @ViewData["Message"]
        </div>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        @if (ViewBag.CanDelete == false)
        {
            <div class="alert alert-warning">@(TempData["DeleteError"] ?? "It can't be deleted while it is still in use. Delete or reassign the items above first.")</div>
        }
        else
        {
            <input type="submit" value="Delete" class="btn btn-danger" /> <text>|</text>
        }
        <a asp-action="Index">Back to List</a>
    </form>
</div>
